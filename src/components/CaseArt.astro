---
// Placeholder artwork for a case study that has no cover image yet.
// Six variations of the sun motif, picked by the case study's position.
interface Props { variant: number; }
const v = ((Astro.props.variant - 1) % 6 + 6) % 6;
const bg = ['#7A2414', '#1E120C', '#F6ECDD', '#1E120C', '#7A2414', '#F6ECDD'][v];
---

<div class="case-art" style={`background:${bg}`}>
  <svg viewBox="0 0 400 300" aria-hidden="true">
    {v === 0 && (
      <>
        <circle cx="200" cy="330" r="190" fill="#F2A93B" />
        <rect x="0" y="210" width="400" height="8" fill="#7A2414" />
        <rect x="0" y="236" width="400" height="12" fill="#7A2414" />
        <rect x="0" y="266" width="400" height="16" fill="#7A2414" />
      </>
    )}
    {v === 1 && (
      <>
        <circle cx="110" cy="150" r="70" fill="#F2A93B" />
        <circle cx="230" cy="150" r="70" fill="none" stroke="#F2A93B" stroke-width="10" />
        <circle cx="330" cy="150" r="30" fill="#7A2414" />
      </>
    )}
    {v === 2 && (
      <>
        <path d="M60 230a140 140 0 0 1 280 0z" fill="#7A2414" />
        <rect x="40" y="244" width="320" height="10" fill="#1E120C" />
      </>
    )}
    {v === 3 && (
      <>
        <circle cx="200" cy="150" r="110" fill="none" stroke="#F2A93B" stroke-width="10" />
        <circle cx="200" cy="150" r="60" fill="#7A2414" />
        <circle cx="310" cy="150" r="14" fill="#F2A93B" />
      </>
    )}
    {v === 4 && (
      <>
        <circle cx="140" cy="150" r="100" fill="#F2A93B" />
        <circle cx="260" cy="150" r="100" fill="#1E120C" opacity=".35" />
      </>
    )}
    {v === 5 && (
      <>
        <rect x="0" y="40" width="400" height="14" fill="#F2A93B" />
        <rect x="0" y="80" width="400" height="20" fill="#F2A93B" />
        <rect x="0" y="128" width="400" height="26" fill="#F2A93B" />
        <circle cx="200" cy="230" r="70" fill="#7A2414" />
      </>
    )}
  </svg>
</div>
