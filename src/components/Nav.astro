---
import { url } from '../data/site';

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/#process', label: 'Process' },
  { href: '/contact/', label: 'Contact' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  const target = url(href).replace(/\/$/, '');
  return !href.includes('#') && (here === target || here.startsWith(target + '/'));
};
---

<header class="nav" transition:persist>
  <a class="brand" href={url('/')}>STUDIO <span>RA HU</span></a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <a class="nav-cta" href={url('/contact/')}>Start a conversation</a>
</header>
