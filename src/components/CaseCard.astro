---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../data/site';

interface Props { entry: CollectionEntry<'work'>; index: number; }
const { entry, index } = Astro.props;
const d = entry.data;
const num = String(d.order).padStart(2, '0');
---

<a class="case" href={url(`/work/${entry.id}/`)} data-reveal style={`--i:${index % 3}`}>
  {d.cover && (
    <div class="case-cover">
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 33vw" />
    </div>
  )}
  <div class="case-no">CASE {num} · {d.sector}</div>
  <h3 transition:name={`case-title-${entry.id}`}>{d.title}</h3>
  <p>{d.disciplines.join(' · ')}</p>
  <div class="case-line">
    <span>{d.steps.join(' → ')}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
</a>
