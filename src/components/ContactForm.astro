---
import { site, url } from '../data/site';
const next = new URL(url('/thanks/'), Astro.site).href;
---

<form action={`https://formsubmit.co/${site.formEmail}`} method="POST" data-reveal>
  <input type="hidden" name="_subject" value="New Studio Ra Hu enquiry" />
  <input type="hidden" name="_next" value={next} />
  <input type="hidden" name="_template" value="table" />
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

  <label for="cf-name">Your name</label>
  <input id="cf-name" required name="name" placeholder="Your name" autocomplete="name" />
  <label for="cf-email">Email address</label>
  <input id="cf-email" required type="email" name="email" placeholder="Email address" autocomplete="email" />
  <label for="cf-company">Company</label>
  <input id="cf-company" name="company" placeholder="Company" autocomplete="organization" />
  <label for="cf-message">What can we help with?</label>
  <textarea id="cf-message" required name="message" rows="5" placeholder="What can we help with?"></textarea>
  <button type="submit">Start a conversation →</button>
</form>
