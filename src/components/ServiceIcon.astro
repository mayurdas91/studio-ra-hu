---
// One sun-shape mark per practice. Drawn in currentColor so CSS can recolour it.
interface Props { id: string; }
const { id } = Astro.props;
---

<svg class="svc-icon" viewBox="0 0 56 56" aria-hidden="true">
  {id === 'digital-marketing' && <circle cx="28" cy="28" r="27" fill="currentColor" />}
  {id === 'brand' && (
    <>
      <path d="M1 28a27 27 0 0 1 54 0z" fill="currentColor" />
      <rect x="1" y="34" width="54" height="4" fill="currentColor" />
    </>
  )}
  {id === 'video' && (
    <>
      <circle cx="28" cy="28" r="25" fill="none" stroke="currentColor" stroke-width="4" />
      <path d="M23 18l14 10-14 10z" fill="currentColor" />
    </>
  )}
  {id === 'software' && (
    <>
      <rect x="2" y="2" width="52" height="52" rx="26" fill="none" stroke="currentColor" stroke-width="4" />
      <path d="M20 22l-7 6 7 6M36 22l7 6-7 6" fill="none" stroke="currentColor" stroke-width="4" />
    </>
  )}
  {id === 'customer-success' && (
    <>
      <circle cx="20" cy="28" r="17" fill="currentColor" />
      <circle cx="36" cy="28" r="17" fill="none" stroke="currentColor" stroke-width="4" />
    </>
  )}
</svg>
