---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---

<Base title="Thank you">
  <section class="page-hero" style="min-height:70vh;border:0">
    <p class="eyebrow" data-reveal>MESSAGE SENT</p>
    <h1 data-reveal style="--i:1">Thank you. We'll be in touch soon.</h1>
    <div class="actions" data-reveal style="--i:2">
      <a class="button" href={url('/work/')}>Browse the work</a>
      <a class="text-link" href={url('/')}>Back to home →</a>
    </div>
  </section>
</Base>
