---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactBand from '../components/ContactBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services, stats, url } from '../data/site';

const featured = (await getCollection('work'))
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const totalServices = services.reduce((n, s) => n + s.deliverables.length, 0);
---

<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>Marketing · Brand · Video · Software · Customer success</p>
      <h1 data-reveal style="--i:1">Make your brand hard to ignore.</h1>
      <p class="lede" data-reveal style="--i:2">Studio Ra Hu brings marketing, brand, video, software and customer success together, so businesses become clearer, more visible and easier to choose.</p>
      <div class="actions" data-reveal style="--i:3">
        <a class="button" href={url('/contact/')}>Work with us</a>
        <a class="button-ghost" href={url('/work/')}>See the work</a>
      </div>
    </div>

    <div class="hero-sun">
      <div class="sun-stage">
        <div class="sun">
          <svg viewBox="0 0 500 500" aria-hidden="true">
            <circle cx="250" cy="250" r="248" fill="#7A2414" />
            <rect x="0" y="338" width="500" height="8" fill="#F2A93B" />
            <rect x="0" y="366" width="500" height="12" fill="#F2A93B" />
            <rect x="0" y="398" width="500" height="16" fill="#F2A93B" />
            <rect x="0" y="434" width="500" height="20" fill="#F2A93B" />
            <rect x="0" y="474" width="500" height="26" fill="#F2A93B" />
          </svg>
          <ul class="sun-stats">
            {stats.map((s) => (
              <li><strong>{s.value}</strong><span>{s.label}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="concept">
    <dl data-reveal>
      <dt>Ra</dt><dd>the light</dd>
      <dt>Hu</dt><dd>the word</dd>
    </dl>
    <h2 data-reveal style="--i:1">We make businesses seen and heard. Strategy that shows people the way, and a voice they remember.</h2>
  </section>

  <section id="services" class="section">
    <div class="section-title" data-reveal>
      <h2>What we do</h2>
      <p>{totalServices} services across {services.length} practices</p>
    </div>
    <div class="svc-grid">
      {services.map((s, i) => (
        <a class="svc" href={url(`/services/#${s.id}`)} data-reveal style={`--i:${i % 5}`}>
          <ServiceIcon id={s.id} />
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="work" class="section">
    <div class="section-title" data-reveal>
      <h2>Selected work</h2>
      <a class="text-link" href={url('/work/')}>All case studies →</a>
    </div>
    <div class="cases">
      {featured.map((entry, i) => <CaseCard entry={entry} index={i} />)}
    </div>
  </section>

  <ContactBand />
</Base>
