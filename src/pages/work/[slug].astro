---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { services, url } from '../../data/site';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[(i - 1 + work.length) % work.length],
      next: work[(i + 1) % work.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const serviceNames = d.services
  .map((id) => services.find((s) => s.id === id)?.title)
  .filter(Boolean);
---

<Base title={d.sector} description={d.summary}>
  <article>
    <header class="cs-hero">
      <a class="cs-back" href={url('/work/')}>← ALL WORK</a>
      <p class="eyebrow" style="margin-top:40px">CASE {String(d.order).padStart(2, '0')} · {d.sector}</p>
      <h1 transition:name={`case-title-${entry.id}`}>{d.title}</h1>
      {d.placeholder && <div class="draft-flag">DRAFT · replace the bracketed text in src/content/work/{entry.id}.md</div>}
    </header>

    <dl class="cs-meta" data-reveal>
      <div>
        <dt>Client</dt>
        <dd>{d.logo ? <Image class="cs-logo" src={d.logo} alt={d.client ?? ''} /> : (d.client ?? 'Confidential')}</dd>
      </div>
      <div><dt>Sector</dt><dd>{d.sector}</dd></div>
      <div><dt>Disciplines</dt><dd>{d.disciplines.join(', ')}</dd></div>
      <div><dt>{d.year ? 'Year' : 'Services'}</dt><dd>{d.year ?? (serviceNames.join(', ') || '—')}</dd></div>
    </dl>

    {d.cover && (
      <div class="cs-cover" data-reveal>
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="80vw" loading="eager" />
      </div>
    )}

    {d.results.length > 0 && (
      <div class="cs-results">
        {d.results.map((r, i) => (
          <div data-reveal style={`--i:${i}`}><strong>{r.value}</strong><span>{r.label}</span></div>
        ))}
      </div>
    )}

    <div class="cs-body">
      <aside data-reveal>
        <p class="eyebrow">PROCESS</p>
        <ol>{d.steps.map((s) => <li>{s}</li>)}</ol>
        {sections.length > 0 && (
          <>
            <p class="eyebrow" style="margin-top:40px">ON THIS PAGE</p>
            <ol>{sections.map((h) => <li><a href={`#${h.slug}`} style="text-decoration:none">{h.text}</a></li>)}</ol>
          </>
        )}
      </aside>
      <div class="prose" data-reveal>
        <Content />
      </div>
    </div>

    <nav class="cs-next" aria-label="More case studies">
      <a href={url(`/work/${prev.id}/`)}>
        <span class="mono">← PREVIOUS · {prev.data.sector}</span>
        <strong>{prev.data.title}</strong>
      </a>
      <a href={url(`/work/${next.id}/`)}>
        <span class="mono">NEXT · {next.data.sector} →</span>
        <strong>{next.data.title}</strong>
      </a>
    </nav>
  </article>
</Base>
